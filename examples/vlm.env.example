# Official Responses-style endpoint
VERIGRAPH_VLM_PROVIDER=responses
VERIGRAPH_VLM_BASE_URL=https://api.openai.com/v1
VERIGRAPH_VLM_MODEL=your-vision-model
VERIGRAPH_VLM_API_KEY=replace-at-runtime
VERIGRAPH_VLM_TIMEOUT=120
VERIGRAPH_VLM_STRUCTURED_OUTPUTS=true
VERIGRAPH_VLM_MAX_RETRIES=2
VERIGRAPH_VLM_RETRY_DELAY=0.5

# For an OpenAI-compatible local server, typically change to:
# VERIGRAPH_VLM_PROVIDER=chat
# VERIGRAPH_VLM_BASE_URL=http://127.0.0.1:8000/v1
# VERIGRAPH_VLM_MODEL=your-local-vlm
# VERIGRAPH_VLM_API_KEY=
# VERIGRAPH_VLM_STRUCTURED_OUTPUTS=false
